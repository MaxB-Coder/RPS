<header class="banner">
  <img src="images/RPS.png" alt="Rock, Paper, Scissors, Spock, Lizard" />
</header>
<p class="who" tabindex="-1">Who is playing?</p>
<form class="text-center" action="game" method="post" data-step="start">
  <div class="names">
    <input class="name" type="text" name="player1" placeholder="Player 1" aria-label="Player 1 name" autocomplete="off" />
    <span class="versus" aria-hidden="true">vs</span>
    <input class="name" type="text" name="player2" placeholder="Player 2" aria-label="Player 2 name" autocomplete="off" />
  </div>
  <input class="cta" type="submit" value="Let's ROCK!" />
</form>
<p class="hint">First to five wins. Take turns on this device, and no peeking.</p>
